<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>de.zbmed</groupId>
	<artifactId>Sip2RosettaApp</artifactId>
	<version>0.0.1</version>
	<properties>
		<jaxb.api.version>2.3.0</jaxb.api.version>
		<jaxb.impl.version>2.3.0</jaxb.impl.version>
		<jaxb.core.version>2.3.0</jaxb.core.version>
		<jaxrs.version>2.3.6</jaxrs.version>
	</properties>
	<!--	<repositories>-->
	<!--		<repository>-->
	<!--			<id>localrepository</id>-->
	<!--			<url>file://${project.basedir}/lib</url>-->
	<!--		</repository>-->
	<!--	</repositories>-->
	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.0</version>
				<configuration>
					<release>11</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>de.zbmed.Sip2RosettaApp</mainClass>
						</manifest>
					</archive>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
					<appendAssemblyId>true</appendAssemblyId>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>						<!-- this is used for inheritance
						merges -->
						<phase>package</phase>						<!-- bind to the packaging phase -->
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
